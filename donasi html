<script>
function filterCategory(cat){
  var cards=document.querySelectorAll('.card');

  cards.forEach(function(card){
    if(cat==='all'){
      card.style.display='block';
    }else{
      if(card.classList.contains(cat)){
        card.style.display='block';
      }else{
        card.style.display='none';
      }
    }
  });
}
</script>

