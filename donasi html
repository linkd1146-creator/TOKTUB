<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Donasi Sosial - MiniTok</title>

<style>
body{
  font-family:Arial;
  margin:0;
  background:#0f172a;
  color:white;
}

header{
  background:#111827;
  padding:16px;
  text-align:center;
  font-size:22px;
  font-weight:bold;
  position:sticky;
  top:0;
  z-index:99;
}

.section{
  max-width:1100px;
  margin:50px auto;
  padding:20px;
}

h2{
  text-align:center;
  margin-bottom:30px;
}

.filter-btn{
  padding:10px 20px;
  border-radius:20px;
  border:none;
  margin:5px;
  cursor:pointer;
  background:#1e293b;
  color:white;
  transition:.3s;
}

.filter-btn:hover{
  background:#00ffcc;
  color:#000;
}

.grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
  gap:20px;
}

.card{
  background:#1e293b;
  padding:20px;
  border-radius:15px;
  transition:.3s;
}

.card:hover{
  transform:translateY(-8px);
  box-shadow:0 10px 25px rgba(0,0,0,.5);
}

.progress{
  background:#0f172a;
  border-radius:10px;
  overflow:hidden;
  height:12px;
  margin:10px 0;
}

.progress-bar{
  height:100%;
  background:#00ffcc;
}

.nominal button{
  margin:5px;
  padding:6px 12px;
  border:none;
  border-radius:15px;
  cursor:pointer;
  background:#334155;
  color:white;
}

.nominal button:hover{
  background:#00ffcc;
  color:black;
}

.report{
  font-size:13px;
  margin-top:10px;
  opacity:.8;
}

.category-section{
  margin-top:60px;
  text-align:center;
}

.category-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(230px,1fr));
  gap:25px;
  margin-top:35px;
}

.category-card{
  background:rgba(255,255,255,0.05);
  padding:25px;
  border-radius:18px;
  transition:all 0.4s ease;
  border:1px solid rgba(255,255,255,0.1);
  backdrop-filter:blur(8px);
}

.category-card:hover{
  transform:translateY(-10px);
  box-shadow:0 15px 35px rgba(0,255,204,0.3);
}

.category-card h3{
  color:#00ffcc;
}

.category-card a{
  display:inline-block;
  margin-top:18px;
  padding:10px 22px;
  background:#00ffcc;
  color:#000;
  border-radius:25px;
  text-decoration:none;
  font-weight:bold;
}

.category-card a:hover{
  background:#00ccaa;
}

html{
  scroll-behavior:smooth;
}

.qris-img{
  width:220px;
  border-radius:15px;
  margin-top:20px;
}

.back-home{
  text-align:center;
  margin-top:40px;
}

.back-home a{
  color:#00ffcc;
  text-decoration:none;
  font-weight:bold;
}
</style>
</head>

<body>

